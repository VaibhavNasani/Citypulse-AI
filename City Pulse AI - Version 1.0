# City Pulse AI - Version 1.1
# Features: city information and AI recommendations

def get_city_info(city):
    cities = {
        "Mumbai": {
            "temperature": 29,
            "air_quality": "Moderate",
            "traffic": "Heavy"
        },
        "Delhi": {
            "temperature": 32,
            "air_quality": "Poor",
            "traffic": "Heavy"
        },
        "Bangalore": {
            "temperature": 25,
            "air_quality": "Good",
            "traffic": "Moderate"
        }
    }

    if city in cities:
        data = cities[city]

        print("City:", city)
        print("Temperature:", data["temperature"], "°C")
        print("Air Quality:", data["air_quality"])
        print("Traffic:", data["traffic"])

        generate_recommendation(data)
    else:
        print("City information not available")


def generate_recommendation(data):
    if data["traffic"] == "Heavy":
        print("AI Recommendation: Avoid peak-hour travel.")

    if data["air_quality"] == "Poor":
        print("AI Recommendation: Consider wearing a mask outdoors.")

    if data["temperature"] > 30:
        print("AI Recommendation: Stay hydrated and avoid excessive heat.")

    if (data["traffic"] != "Heavy"
            and data["air_quality"] != "Poor"
            and data["temperature"] <= 30):
        print("AI Recommendation: Conditions are suitable for normal activities.")


get_city_info("Mumbai")
